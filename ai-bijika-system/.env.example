PORT=3300
# DATA_DIR=./data
# /admin/inquiries（お問い合わせ管理画面）のパスワード。本番では必ず設定する
ADMIN_PASSWORD=changeme
# 有料ツール（/tools/shukyaku＝980円・/tools/kanyu＝1,480円）のパスワード。本番では必ず設定し、
# Tips購入後に/contact経由で本人確認した上で購入者へ案内する
SHUKYAKU_TOOL_PASSWORD=changeme
KANYU_TOOL_PASSWORD=changeme
# SNS自動投稿連携（/admin/sns）用。ポストメッシュ（https://post-mesh.com/）のダッシュボードで
# SNSアカウントを連携し、発行したAPIキーを設定する。未設定でも起動はできるが機能は使えない
POSTMESH_API_KEY=
