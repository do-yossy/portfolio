PORT=3300
# DATA_DIR=./data
# /admin/inquiries（お問い合わせ管理画面）のパスワード。本番では必ず設定する
ADMIN_PASSWORD=changeme
# 有料ツール（/tools/shukyaku＝980円・/tools/kanyu＝1,480円・/tools/jidoutoukou＝SNS自動投稿ツール）のパスワード。
# 本番では必ず設定し、Tips購入後に/contact経由で本人確認した上で購入者へ案内する。
# /tools/jidoutoukouの利用には、購入者自身のポストメッシュ（https://post-mesh.com/）アカウント・
# APIキーが別途必要（運営者側では管理しない。画面から毎回受け取るだけでDB・ログには保存しない）
SHUKYAKU_TOOL_PASSWORD=changeme
KANYU_TOOL_PASSWORD=changeme
JIDOUTOUKOU_TOOL_PASSWORD=changeme
# 上記3つの「ギフト用パスワード」（任意）。設定すると、購入者用パスワードとは別にこちらでも
# ログインできるようになる。無償プレゼント（アポミー再アプローチ等）専用に発行し、
# 流出・乱用が疑われたらこちらだけを変更して無効化できる（購入者用パスワードは影響しない）。
# 未設定ならギフト用ログインは無効（購入者用パスワードのみで動作する）
SHUKYAKU_GIFT_PASSWORD=
KANYU_GIFT_PASSWORD=
JIDOUTOUKOU_GIFT_PASSWORD=
# 「かんたん版」（/tools/shukyaku-kantan・/tools/kanyu-kantan）用。通常版とは別の独立した
# パスワード・別の価格の商品。購入者のAPIキー入力を不要にする代わりに、下のSHARED_AI_API_KEY
# （運営者自身のAIプロバイダAPIキー）をサーバー側で使って生成する
SHUKYAKU_KANTAN_TOOL_PASSWORD=changeme
KANYU_KANTAN_TOOL_PASSWORD=changeme
# かんたん版の生成に使う、運営者自身のAIプロバイダAPIキー。購入者ごとに使用量を分けられないため、
# 1日あたりの生成回数を各ツールで上限管理する（SHUKYAKU_KANTAN_DAILY_LIMIT・KANYU_KANTAN_DAILY_LIMIT、
# 未設定時は1日30回）。未設定だとかんたん版は利用できない
SHARED_AI_PROVIDER=openai
SHARED_AI_API_KEY=
# SHUKYAKU_KANTAN_DAILY_LIMIT=30
# KANYU_KANTAN_DAILY_LIMIT=30
