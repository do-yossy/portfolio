PORT=3300
# DATA_DIR=./data
# /admin/inquiries（お問い合わせ管理画面）のパスワード。本番では必ず設定する
ADMIN_PASSWORD=changeme
# 有料ツール（/tools/shukyaku＝980円・/tools/kanyu＝1,480円・/tools/jidoutoukou＝SNS自動投稿ツール）のパスワード。
# 本番では必ず設定し、Tips購入後に/contact経由で本人確認した上で購入者へ案内する。
# /tools/jidoutoukouの利用には、購入者自身のポストメッシュ（https://post-mesh.com/）アカウント・
# APIキーが別途必要（運営者側では管理しない。画面から毎回受け取るだけでDB・ログには保存しない）
SHUKYAKU_TOOL_PASSWORD=changeme
KANYU_TOOL_PASSWORD=changeme
JIDOUTOUKOU_TOOL_PASSWORD=changeme
# 上記3つの「ギフト版」（/tools/shukyaku-gift・/tools/kanyu-gift・/tools/jidoutoukou-gift、
# 購入者版とは別URL）用のパスワード（任意）。無償プレゼント（アポミー再アプローチ等）専用に
# 発行し、ツール本体は購入者版と同じものを使う。購入者用パスワードとは別の環境変数のため、
# 流出・乱用が疑われたらこちらだけを変更して無効化でき、購入者版には一切影響しない。
# 未設定ならギフト版ログインは常に失敗する（安全側。購入者版の動作には影響しない）
SHUKYAKU_GIFT_PASSWORD=
KANYU_GIFT_PASSWORD=
JIDOUTOUKOU_GIFT_PASSWORD=
# 「かんたん版」（/tools/shukyaku-kantan・/tools/kanyu-kantan）用。通常版とは別の独立した
# パスワード・別の価格の商品。購入者のAPIキー入力を不要にする代わりに、下のSHARED_AI_API_KEY
# （運営者自身のAIプロバイダAPIキー）をサーバー側で使って生成する
SHUKYAKU_KANTAN_TOOL_PASSWORD=changeme
KANYU_KANTAN_TOOL_PASSWORD=changeme
# かんたん版の生成に使う、運営者自身のAIプロバイダAPIキー。購入者ごとに使用量を分けられないため、
# 1日あたりの生成回数を各ツールで上限管理する（SHUKYAKU_KANTAN_DAILY_LIMIT・KANYU_KANTAN_DAILY_LIMIT、
# 未設定時は1日30回）。未設定だとかんたん版は利用できない
SHARED_AI_PROVIDER=openai
SHARED_AI_API_KEY=
# SHUKYAKU_KANTAN_DAILY_LIMIT=30
# KANYU_KANTAN_DAILY_LIMIT=30

# ── 月額SNS自動投稿サービス（/service）──
# 詳しい設定手順は docs/月額SNS自動投稿サービス_セットアップ手順.md
# サービスの公開URL（https://から始まるもの。StripeやSNSの戻り先に使う）
# SERVICE_BASE_URL=https://example.com
# SERVICE_NAME=ミチシルベ 自動投稿
# 特商法表記・プライバシーポリシーの連絡先に表示するメールアドレス（必須）
# SERVICE_CONTACT_EMAIL=
# 販売開始の合図。使うSNSの審査（SNS_APPROVED）と、テストモードでの動作確認が終わってから true にする。それまで販売ページは「準備中」になる
# （審査済みのSNS（SNS_APPROVED）が1つも無い間と、法務文書に未記入の【】が残っている間は、true にしても「準備中」のまま）
# SERVICE_OPEN=true
# 各SNSの審査（MetaのApp Reviewなど）を通り、アプリをライブにしたSNSの id（カンマ区切り。threads・instagram・facebook・tiktok・youtube・x）。
# 入っていないSNSは、キーを入れても一般の利用者には「準備中」と表示し、テスト利用の利用者だけが連携できる（「審査前（テスト利用のみ）」と表示）。
# TikTokは、アプリの審査を通ったら tiktok を足す（監査の前に一般の利用者が連携できるかは未確認・実物で確かめる。投稿の監査（Audit）は、別に TIKTOK_AUDITED で示す）
# SNS_APPROVED=threads
# 法務文書（規約・特商法表記・プライバシーポリシー）の確定。運営者（必要に応じて弁護士などの専門家）が内容を確かめてから true にする。
# Threads は、受け口の確認（セットアップ手順2-2の8）で(a)（連携が消えて知らせが出る）になってから true にする（プライバシーポリシーの5の約束のため）。
# URLの登録・本番への反映・THREADS_APP_SECRET の3点が合っていても知らせが届かないときは、開発に相談し、プライバシーポリシーの見直しを決めるまで true にしない（セットアップ手順2-2の8の4）。
# Instagram・Facebook は、SNS_APPROVED に入れる前に、同じ手順で(a)になることを確かめる（セットアップ手順2-3-1の8・2-3-4の7）
# 未記入の【】が無ければ、販売の開始前でも「（案）」と草案の注意書きを外す（各SNSの審査に、確定版を見せるため）
# LEGAL_FINAL=true
# 法務文書の置き場所（任意。未設定ならリポジトリの legal/）。設定している場合は、legal/ の変更をこの場所の文書にも反映する（反映しないと公開ページは古いまま）
# SERVICE_LEGAL_DIR=
# 表示する月額（Stripeで作る価格と同じ金額にすること）
# SERVICE_PRICE_JPY=1100          # Stripeの価格と、規約・特商法表記の金額と必ずそろえる
# SERVICE_REPRESENTATIVE=         # プライバシーポリシーの代表者の氏名（販売前に必須）
# SERVICE_TRIAL_DAYS=             # 無料期間の日数（1〜30。未設定なら無料期間なし）
# SERVICE_ONLY=true               # この商品専用のアプリとして動かす（専用アプリの fly.sns.toml で設定済み）
# SERVICE_MOVED_TO=               # ミチシルベ本体側：/service を専用アプリへ転送する（例：https://michishirube-post.fly.dev）
# Stripe（決済）。STRIPE_PRICE_ID は、Stripeで作成した月額の「価格」のID（price_...）
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
# SNSのトークンをDBに保存するときの暗号化キー（64桁の16進数。生成例: openssl rand -hex 32）。変更すると連携済みのアカウントが使えなくなる
# SNS_TOKEN_KEY=
# CSRFトークンの秘密鍵（必須。未設定だと再起動のたびに変わり、開いていた画面の操作が失敗する）
# APP_SECRET=                     # 必須（64桁の16進数。openssl rand -hex 32）
# Threads・Instagram（Metaの開発者アプリ）、TikTok（TikTok for Developers）、X（X Developer Portalのアプリ）の連携用キー
# Threadsは、Threads用のアプリIDとシークレット（管理画面の Threads app ID・Threads app secret。メインのアプリIDとシークレットではない）
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# Facebookページ（Facebookログイン。アプリレビューが必要）
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# Metaの3つのアプリ（Threads・Instagram・Facebook）の管理画面に登録するURL（<SNS> は threads／instagram／facebook。ログイン不要）。
#   連携の取り消し（Deauthorize）：SERVICE_BASE_URL/service/meta/<SNS>/deauthorize
#   データ削除の求め（Data Deletion Request）：SERVICE_BASE_URL/service/meta/<SNS>/data-deletion
#   データ削除の手順のURL：SERVICE_BASE_URL/service/legal/data-deletion（「設定」→「ベーシック」のユーザーデータの削除の欄に入れる。
#   この欄でコールバックと手順のどちらを選べるかは、画面で確かめる）
#   届く signed_request は、上の *_APP_SECRET で確かめる（どのシークレットで署名されるかは未確認。テスターで実物を受けて確かめる）
# YouTube（Google OAuth。YouTube Data API v3。審査が必要）
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_AUDITED=true      # TikTokの投稿の監査（Audit）を通った後にだけ設定する（アプリの審査を通っただけなら、SNS_APPROVED に tiktok を足すだけ）。未設定の間は、公開範囲は「自分のみ」だけを選べる
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# --- AIによる文章・画像・動画の生成（任意。キーを入れたものだけ有効になる）---
# ANTHROPIC_API_KEY=      # 文章（AI_TEXT_MODEL で変更可。既定 claude-haiku-5-5）
# OPENAI_API_KEY=         # 画像（JPEGで生成。AI_IMAGE_MODEL で変更可）
# GEMINI_API_KEY=         # 動画（Veo。AI_VIDEO_MODEL で変更可。生成に数分かかる）
# 1人あたり・1日あたりの生成回数の上限（費用の管理用。AIの料金は各社の公式で確認して決める）
# AI_DAILY_TEXT=30
# AI_DAILY_IMAGE=5
# AI_DAILY_VIDEO=0        # 動画は既定で無効（当面は文章と画像だけを提供する）
# AI_IMAGE_QUALITY=medium # 画像の品質（low／medium／high。高いほど費用が上がる）
# 1人あたり・1か月あたりの上限（日本時間の暦月）
# AI_MONTHLY_TEXT=300
# AI_MONTHLY_IMAGE=60
# AI_MONTHLY_VIDEO=10

# --- 上限（任意。既定値は括弧内）---
# SERVICE_MAX_ACCOUNTS=10     # 1人が連携できるSNSアカウント数
# SERVICE_MAX_PENDING=300     # 未投稿の予約の件数
# SERVICE_MAX_PER_DAY=50      # 1日に予約できる件数（日本時間）
# YOUTUBE_DAILY_LIMIT=90     # YouTubeへのアップロードの、サービス全体の1日（太平洋時間）の上限（初期の割り当ては1日100回）
# YOUTUBE_PER_USER_DAILY=5   # YouTubeへのアップロードの、利用者ごとの1日（太平洋時間）の上限（1人で全体の枠を使い切らないように）
# X_MONTHLY_LIMIT=30          # Xへの投稿の月の上限（XのAPIは投稿数に応じて費用がかかる。ツリーは1件ずつ数える）
