# ================= 求人ボックス専用システム .env サンプル =================
# このファイルを .env にコピーして値を設定してください（.env はコミットされません）
# copy .env.example .env

# サーバーのポート（現システムと別ポートにすること。既定 3200）
PORT=3200

# ---- 求人ボックス認証（会社ごと） --------------------------------
# <CO> は会社ID大文字（sq→SQ, bg→BG, pe→PE, lt→LT, nc→NC, nx→NX）
# 会社別が無い場合は無印（KYUJINBOX_EMAIL 等）にフォールバックします。

# 例）Social Quality（SQ）
KYUJINBOX_EMAIL_SQ=
KYUJINBOX_PASSWORD_SQ=
KYUJINBOX_GROUP_ID_SQ=
# KYUJINBOX_PHONE_SQ=            # 表示電話番号（不要なら空）
# KYUJINBOX_JOB_IMAGE_SQ=       # 掲載画像URL

# 例）BigEyes（BG）
KYUJINBOX_EMAIL_BG=
KYUJINBOX_PASSWORD_BG=
KYUJINBOX_GROUP_ID_BG=
# KYUJINBOX_JOB_IMAGE_BG=

# ---- AI改善（Claude API） ----------------------------------------
# 本物のキーを設定（未設定だと改善案生成は動きません）
ANTHROPIC_API_KEY=sk-ant-your-key-here
# 使用モデル（既定 claude-sonnet-5・品質重視）
OPTIMIZER_MODEL=claude-sonnet-5

# 改善検知のしきい値
OPT_MIN_AGE_DAYS=3
OPT_VIEW_FLOOR=30
OPT_COOLDOWN_DAYS=5
OPT_MAX_COUNT=3

# Python 実行パス（自動検出しますが固定したい場合に）
# PYTHON_PATH=python
