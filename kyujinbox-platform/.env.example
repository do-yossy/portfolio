# ================= 求人ボックス専用システム .env サンプル =================
# このファイルを .env にコピーして値を設定してください（.env はコミットされません）
# copy .env.example .env

# サーバーのポート（現システムと別ポートにすること。既定 3200）
PORT=3200

# ---- 管理画面ログイン（現システムと同じ値にすれば同じログイン情報でログイン可）----
# 現システム(recruitment-platform)の .env と同じ ADMIN_USER / ADMIN_PASSWORD を設定してください。
# ※ ADMIN_PASSWORD が空だとログイン無し（開放）になります。運用時は必ず設定してください。
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---- 求人ボックス認証（会社ごと） --------------------------------
# <CO> は会社ID大文字（sq→SQ, bg→BG, pe→PE, lt→LT, nc→NC, nx→NX）
# 会社別が無い場合は無印（KYUJINBOX_EMAIL 等）にフォールバックします。

# 例）Social Quality（SQ）
KYUJINBOX_EMAIL_SQ=
KYUJINBOX_PASSWORD_SQ=
KYUJINBOX_GROUP_ID_SQ=
# KYUJINBOX_PHONE_SQ=            # 表示電話番号（不要なら空）
# KYUJINBOX_JOB_IMAGE_SQ=       # 掲載画像URL

# 例）BigEyes（BG）
KYUJINBOX_EMAIL_BG=
KYUJINBOX_PASSWORD_BG=
KYUJINBOX_GROUP_ID_BG=
# KYUJINBOX_JOB_IMAGE_BG=

# ---- AI改善（Claude API） ----------------------------------------
# 本物のキーを設定（未設定だと改善案生成は動きません）
ANTHROPIC_API_KEY=sk-ant-your-key-here
# 使用モデル（既定 claude-sonnet-5・品質重視）
OPTIMIZER_MODEL=claude-sonnet-5

# 改善検知のしきい値
OPT_MIN_AGE_DAYS=3
# 掲載からの上限日数（0=上限なし。例: 21 で「掲載3週間以内・応募0」の求人だけ改善）
OPT_MAX_AGE_DAYS=0
OPT_VIEW_FLOOR=30
OPT_COOLDOWN_DAYS=5
OPT_MAX_COUNT=3

# Python 実行パス（自動検出しますが固定したい場合に）
# PYTHON_PATH=python

# ---- VPN（投稿時にアカウント毎へ自動切替・確認） ----------------
# 投稿の各アカウント処理の前に、システムが自動でVPNを接続・確認してから投稿します。
#
# ■ 会社ごとに別IP（別VPN）で運用する場合（推奨・アカウント毎に自動切替）
#   会社別にSoftEtherの「接続設定名」を割り当てます（IPそのものではありません）。
#   投稿時に他のVPNを切断→その会社用VPNへ自動で切り替えます。
#   ※ 接続設定名は固定でOK。IPが毎回変わっても、システムが投稿直前に実際の
#     グローバルIPを取得してログに表示し、直前のアカウントとIPが被った場合は
#     自動で再接続してIPを変えます（アカウント毎に別IPを保証）。
# VPNCMD_ACCOUNT_SQ=（SQ用のSoftEther接続設定名）
# VPNCMD_ACCOUNT_BG=（BG用のSoftEther接続設定名）
#
# ■ 全アカウント同じVPNでよい場合
#   何も設定しなければ、登録済みVPNへ自動接続（既に接続中ならそのまま利用）。
# VPNCMD_ACCOUNT=（共通で使う接続設定名。任意）
# vpncmd.exe のパス（自動検出しますが固定したい場合に）
# VPNCMD_PATH=C:\Program Files\SoftEther VPN Client\vpncmd.exe
# vpncmdが無い環境でIPで判定する場合（許可するグローバルIPの範囲、カンマ区切り）
# VPN_IP_RANGES=203.0.113
# テスト時にVPNチェックを無効化（本番では外す）
# VPN_BYPASS=true

# ---- 人材紹介求人の表示（職業安定法の記載義務） ----------------
# 人材紹介求人には「人材紹介である旨」を自動で本文に付与します。
# 有料職業紹介事業の許可番号を設定すると、記載文に差し込まれます（例: 13-ユ-000000）。
AGENCY_LICENSE_NO=
# 記載文を全文上書きしたい場合はこちらに（設定すると上の許可番号は無視されます）
# AGENCY_NOTICE=
