# ── サーバー設定 ──────────────────────────────
PORT=3000
SITE_URL=https://social-quality.com
COMPANY_NAME=株式会社Social Quality
SITE_NAME=採用サイト

# ── 管理者認証 ────────────────────────────────
# 必ず変更してください（空のまま本番起動すると誰でも管理画面にアクセスできます）
ADMIN_USER=admin
ADMIN_PASSWORD=

# ── Anthropic API（AI原稿生成用）────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── メール通知（SMTP） ───────────────────────────
# Gmail の場合: Googleアカウント → セキュリティ → アプリパスワード で発行
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=your-email@gmail.com
ADMIN_EMAIL=recruiter@example.com

# ── 求人ボックス（Playwright自動投稿用） ──────────
# 【既定アカウント】会社を指定しない/該当の会社別設定が無い場合に使う値
KYUJINBOX_EMAIL=your-kyujinbox-email@example.com
KYUJINBOX_PASSWORD=your-kyujinbox-password
# KYUJINBOX_GROUP_ID=G0000-0000-0000   # ログイン後URL saiyo.kyujinbox.com/company/groups/【ここ】/jobs
# KYUJINBOX_PHONE=                       # 求人に表示する電話番号（不要なら空でOK）
# KYUJINBOX_JOB_IMAGE=images/xxxx.jpg    # 掲載写真（任意）
KYUJINBOX_BATCH_SIZE=5

# 【会社別アカウント（複数アカウント同時投稿用）】
# 会社IDの大文字を末尾に付ける（sq→_SQ, bg→_BG, pe→_PE, lt→_LT, nc→_NC, nx→_NX）。
# 会社を選んで投稿するとその会社の値を使用。会社「すべて」で投稿すると設定済みの全社へ順に投稿。
# 会社名は会社マスタ(db.js)の正式名称が自動で使われます。
# 例）Bigeyes(bg) のアカウント:
# KYUJINBOX_EMAIL_BG=bigeyes@example.com
# KYUJINBOX_PASSWORD_BG=your-password
# KYUJINBOX_GROUP_ID_BG=G5148-4590-0001
# KYUJINBOX_JOB_IMAGE_BG=images/cosme-seizou.jpg
# 例）SocialQuality(sq) のアカウント（無印の KYUJINBOX_EMAIL を使う場合は不要）:
# KYUJINBOX_EMAIL_SQ=sq@example.com
# KYUJINBOX_PASSWORD_SQ=your-password
# KYUJINBOX_GROUP_ID_SQ=G0000-0000-0000
# 例）Brand ideaL(bi) のアカウント:
# KYUJINBOX_EMAIL_BI=brandideal@example.com
# KYUJINBOX_PASSWORD_BI=your-password
# KYUJINBOX_GROUP_ID_BI=G0000-0000-0000
# 例）NOWLIVE(nl) のアカウント:
# KYUJINBOX_EMAIL_NL=nowlive@example.com
# KYUJINBOX_PASSWORD_NL=your-password
# KYUJINBOX_GROUP_ID_NL=G0000-0000-0000

# ── スタンバイ（XMLフィード連携 / Playwright投稿用）──
STANBY_EMAIL=your-stanby-email@example.com
STANBY_PASSWORD=your-stanby-password

# ── Indeed ─────────────────────────────────────
INDEED_EMAIL=your-indeed-email@example.com
INDEED_PASSWORD=your-indeed-password
# 会社別アカウント（記録用）。Indeedは自動投稿を行わないため、
# 会社ごとのログイン情報を控えとして保存する用途。会社IDの大文字を末尾に付ける。
# 例）Brand ideaL(bi):
# INDEED_EMAIL_BI=brandideal@example.com
# INDEED_PASSWORD_BI=your-password
# 例）NOWLIVE(nl):
# INDEED_EMAIL_NL=nowlive@example.com
# INDEED_PASSWORD_NL=your-password

# ── engage（エンゲージ / Playwright自動投稿） ──
# engageはbot検知があるため、投稿本体(engage_poster.py)は実Chromeプロファイルを使い、
# 一度手動ログインしたセッションを再利用する（会社別に別プロファイル）。
# 投稿に必須なのは ENGAGE_PK（求人作成フォームURL末尾の企業PK）。
#   フォームURL例: https://en-gage.net/company/job/regist/form/?PK=C6F2D9  → PK=C6F2D9
# 【推奨】engageは自動起動ブラウザのログインを弾くため、あなたが起動した“普通のChrome”に
# 接続する方式(CDP)を使う。Chromeを次のように起動して engage にログインしておく:
#   "C:\Program Files\Google\Chrome\Application\chrome.exe" --remote-debugging-port=9222 --user-data-dir="%USERPROFILE%\engage-chrome"
# その上で poster を CDP接続で実行:
#   set ENGAGE_PK=<PK> && set ENGAGE_CDP_URL=http://localhost:9222 && type test-engage.json | python scripts/engage_poster.py
# ENGAGE_CDP_URL=http://localhost:9222
# 会社別（会社IDの大文字を末尾に付ける）:
# ENGAGE_PK_NL=XXXXXX
# ENGAGE_EMAIL_NL=nowlive@example.com     # 記録用（任意）
# ENGAGE_PASSWORD_NL=your-password        # 記録用（任意）
# ENGAGE_HEADLESS=0                        # 初回ログイン時は 0（表示）。以降は 1 でも可
# ENGAGE_PROFILE_DIR=                      # 未設定なら engage-profile-<会社ID> を自動使用

# ── VPN IPレンジ ───────────────────────────────
# 使用するVPNのIPプレフィックスをカンマ区切りで入力（例: 203.0.113.）
# 空の場合はVPN確認をスキップ
VPN_IP_RANGES=

# ── Google スプレッドシート連携（架電リスト共有） ──
# 設定方法は GOOGLE_SHEETS_SETUP.md を参照
# サービスアカウント鍵(JSON)。JSON文字列・base64・ファイルパスのいずれか
GOOGLE_SERVICE_ACCOUNT_JSON=
# 管理用（架電リスト）スプレッドシートのID（URL の /d/〜/edit の間）
GOOGLE_SHEET_ID=
# 過去応募者（アーカイブ済み）を出力する別スプレッドシートのID（任意）
# 設定すると過去応募者タブの「過去リストを別シート出力」ボタンが有効になります
GOOGLE_PAST_SHEET_ID=
