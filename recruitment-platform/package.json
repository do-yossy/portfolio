{
  "name": "recruitment-platform",
  "version": "1.0.0",
  "description": "ATS採用プラットフォーム + 媒体運用自動化システム",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "seed:accounts": "node --experimental-sqlite scripts/setup-kyujinbox-accounts.js",
    "seed:restock": "node --experimental-sqlite scripts/seed-sq-weekly-restock-kyujinbox.js && node --experimental-sqlite scripts/seed-bg-weekly-restock-kyujinbox.js"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
