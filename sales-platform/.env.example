# 営業バックエンド 環境変数
PORT=3100
ADMIN_PASSWORD=ここに管理パスワードを設定
SALES_GOAL=1000000
PORTFOLIO_BASE=https://do-yossy.github.io/portfolio/

# Claude（取込時／✨生成ボタンで「提案文＋成果物」を自動生成）。未設定なら採点のみ。
#   本番は fly secrets set ANTHROPIC_API_KEY="sk-ant-..."（.env はコミットしない）
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# 通知（任意）。問い合わせ＋AI返信ドラフト＋コンテンツ売上がここに届く
SLACK_WEBHOOK_URL=

# コンテンツ売上アラートの自分宛メール先（任意）。Brain/Tips/note 等で購入があると
#   /api/inbound (kind:sale) 経由でここへ「🎉 売上」メールが届く（Resend設定時のみ）。
#   未設定なら MAIL_REPLY_TO を代用。メール送信自体は RESEND_API_KEY/MAIL_FROM が必要。
NOTIFY_EMAIL=

# 媒体メッセージ受信(/api/inbound)用の共有トークン。Apps Script「媒体メール通知.gs」と同じ値にする。
#   未設定なら ADMIN_PASSWORD（管制塔ログインPW）を自動で代用するので、新たに設定しなくてもよい。
#   専用トークンにしたい時のみ: fly secrets set INBOUND_TOKEN="ランダムな秘密文字列"
INBOUND_TOKEN=

# 自動受付メール（任意・Resend）。設定すると問い合わせ者へ受付メールを自動送信。
#   MAIL_FROM のドメインは Resend で認証(DNS)済みにすること。未設定なら受付メールは送らない（AI返信ドラフトのSlack通知は動く）。
#   fly secrets set RESEND_API_KEY="re_..." MAIL_FROM="株式会社Social Quality <info@social-quality.com>" MAIL_REPLY_TO="social.recruiting.information@gmail.com"
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=
# 本番DB（任意・設定すればPostgres運用に拡張）
# DATABASE_URL=postgres://...

# Googleスプレッドシート連携（サービスアカウント・方式B）
SHEET_ID=1I9ZQlt6RgzMZBMavaLcmXeDznLUrvveXsK9WrhHB4qM
SHEET_RANGE=A2:I200
# ↓ サービスアカウント鍵JSON（1行化）。絶対に .env をコミットしない。本番は fly secrets set で設定:
#   fly secrets set GOOGLE_SERVICE_ACCOUNT_JSON="$(cat service-account.json)"
GOOGLE_SERVICE_ACCOUNT_JSON=
